PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=SLA_DB
# Alternativa a PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE:
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/sla_control
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Dirección pública del frontend usada en enlaces de recuperación (HTTPS en producción).
FRONTEND_PUBLIC_URL=http://127.0.0.1:4000
# SMTP: configura estas variables en backend\.env, nunca en el repositorio.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
